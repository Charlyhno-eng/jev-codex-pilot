{
  "name": "jev-codex-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "jc-pilot": "./bin/jc-pilot.ts"
  },
  "scripts": {
    "setup:cli": "node bin/install-command.ts",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint --flag unstable_native_nodejs_ts_config . --ext .js,.mjs,.cjs,.ts,.tsx",
    "start": "tsx src/api/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.87",
    "@vitejs/plugin-react": "latest",
    "ai": "^7.0.107",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "tsx": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "latest",
    "typescript-eslint": "^8.71.1",
    "vitest": "latest"
  }
}
